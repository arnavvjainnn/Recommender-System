# Application Environment Configuration
APP_NAME="RecommendAI API"
DEBUG=True
SECRET_KEY="supersecretrecommendai-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default: Local SQLite database
DATABASE_URL="sqlite:///./recommendai.db"
# For PostgreSQL container:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recommendai_db"

# Hybrid Recommendation Model Weights
WEIGHT_COLLABORATIVE=0.45
WEIGHT_CONTENT=0.35
WEIGHT_POPULARITY=0.20
MMR_DIVERSITY_LAMBDA=0.75
INTERACTION_HALF_LIFE_DAYS=30.0
RANDOM_SEED=42
